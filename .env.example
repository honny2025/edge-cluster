# ---------------------------------------------------------------------------
# 环境变量覆盖示例
#
# 用法：复制为 .env 并按需修改，或直接 export 到 shell。
#       （.env 已在 .gitignore 中，不会被提交）
#
# 命名规则：EDGE_<段名>__<键名> —— 注意是**双下划线**分隔段与键，
#         段名与键名均大写。例：config.toml 的 [server].port
#         → EDGE_SERVER__PORT
#
# ⚠️ 修改后可用 `python docs/acceptance/config_check.py` 验证是否生效。
#    历史上这里踩过一个坑：前缀长度算错导致**整段覆盖逻辑静默失效**
#    （不报错、不生效），现在已修复并有 8 项回归自检守着。
# ---------------------------------------------------------------------------

# --- 平台服务端 -----------------------------------------------------------------

# REST/WS 监听端口。被占用时不必改 config.toml，用它即可。
EDGE_SERVER__PORT=8000

# 监听地址。0.0.0.0 = 允许局域网内其他机器访问（手机接入需要）。
# 只在本机用可改 127.0.0.1。
EDGE_SERVER__HOST=0.0.0.0

# ⚠️ 共享 token —— 必须与 node-agent 的 token 一致。
#    默认值 edge-cluster-dev-token 仅用于开发，任何人都能从文档里看到它。
#    里程碑 4 之后，这个 token 等于「在节点上执行命令」的能力，
#    在不可信网络上部署前请务必改掉（两侧都要改，且保持一致）。
EDGE_SERVER__TOKEN=edge-cluster-dev-token

# 日志级别：DEBUG / INFO / WARNING / ERROR
EDGE_SERVER__LOG_LEVEL=INFO

# UDP 局域网自动发现端口
EDGE_SERVER__DISCOVERY_PORT=37020

# 是否托管前端静态文件（web/dist）。关掉就只剩 API。
EDGE_WEB__SERVE_STATIC=true

# --- 心跳与离线判定 -------------------------------------------------------------
#
# ⚠️ 这两个参数共同决定「离线」需要多久，别只看其中一个：
#    实际落库时间 ≈ offline_threshold + offline_confirm_times × heartbeat_interval
#    默认 15 + 3×5 = 约 30s（实测约 20~25s）
#    offline_confirm_times=1 即严格 15s，代价是网络抖动时状态会闪烁。

# 心跳超时阈值（秒）
EDGE_SERVER__OFFLINE_THRESHOLD=15

# 连续 N 次巡检确认才落库为 offline（防抖）
EDGE_SERVER__OFFLINE_CONFIRM_TIMES=3

# Agent 心跳间隔（秒）。改这里要同步改 node-agent/config.toml。
EDGE_SERVER__HEARTBEAT_INTERVAL=5

# --- 告警阈值 -------------------------------------------------------------------
# 注意：指标取不到（null）时**一律不告警** —— 没有数据不等于异常。

EDGE_ALERTS__ENABLED=true
EDGE_ALERTS__CPU_USAGE_WARN=85.0        # CPU 使用率 % ≥ 此值告警
EDGE_ALERTS__MEM_USAGE_WARN=85.0
EDGE_ALERTS__STORAGE_USAGE_WARN=90.0
EDGE_ALERTS__TEMPERATURE_WARN=45.0      # ℃
EDGE_ALERTS__TEMPERATURE_CRITICAL=55.0  # ℃
EDGE_ALERTS__ALARM_ON_OFFLINE=true      # 节点离线是否告警
EDGE_ALERTS__PROBE_TIMEOUT_WARN=3       # 服务探活连续失败 N 次判 error（M4 用）

# --- 配置来源 -------------------------------------------------------------------
# 指定另一份 config.toml（默认找 server/config.toml）
# EDGE_CONFIG_FILE=E:\path\to\my-config.toml

# --- Agent 侧（在手机上设置，或写进 node-agent/config.toml）------------------------
# 平台地址。局域网自动发现失败时用它兜底。
# EDGE_AGENT__PLATFORM_URL=http://192.168.1.100:8000
# 必须与平台一致
# EDGE_AGENT__TOKEN=edge-cluster-dev-token
# 心跳间隔，与平台保持一致
# EDGE_AGENT__HEARTBEAT_INTERVAL=5

# --- 本机环境补丁（历史上踩过的坑）----------------------------------------------
# 本机若设了 HTTP_PROXY，websockets 会自动走代理并拒绝连接 127.0.0.1，
# 表现为 `proxy rejected connection: HTTP 502`。
# 代码里已显式 proxy=None，但某些环境仍需显式声明 no_proxy：
NO_PROXY=127.0.0.1,localhost
no_proxy=127.0.0.1,localhost
